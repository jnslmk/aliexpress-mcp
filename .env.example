# AliExpress MCP — no API key required.
#
# There is no official AliExpress product API; this server talks to the public
# aliexpress.com frontend (SSR search pages + the internal MTop API). Nothing
# here is secret — these just tune the target market.

# Market: ship-to region, display currency and locale. Defaults target Germany.
AE_REGION=DE
AE_CURRENCY=EUR
AE_LOCALE=de_DE

# curl_cffi TLS-impersonation profile (Chrome by default). Rarely needs changing.
# AE_IMPERSONATE=chrome

# Browser fallback uses the pinned Obscura pair bundled in Docker, not Chromium.
# Local installs must provision the official render-enabled stealth v0.2.6 pair.
# AE_OBSCURA_BINARY=/opt/obscura/obscura
# AE_BROWSER_ENABLED=true
# AE_BROWSER_TIMEOUT_MS=45000
# AE_BROWSER_ATTEMPTS=3
# AE_BROWSER_RETRY_DELAY_S=1.5
# AE_TIMEZONE=Europe/Berlin
# AE_VIEWPORT_WIDTH=1440
# AE_VIEWPORT_HEIGHT=900

# Transport: "http" (default, streamable-HTTP on :8000/mcp) or "stdio".
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp

# LOG_LEVEL=INFO
